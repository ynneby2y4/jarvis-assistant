# Environment
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./jarvis.db
# For production: postgresql://user:password@localhost/jarvis_prod

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Exchange API Keys (Encrypt these in production!)
BINANCE_API_KEY=your-binance-key
BINANCE_API_SECRET=your-binance-secret
COINBASE_API_KEY=your-coinbase-key
KRAKEN_API_KEY=your-kraken-key
KRAKEN_API_SECRET=your-kraken-secret

# Redis
REDIS_URL=redis://localhost:6379/0

# Income Generation
INCOME_ENGINE_ENABLED=True
REQUIRE_APPROVAL=True
APPROVAL_TIMEOUT=300

# Risk Management
MAX_DAILY_LOSS=1000
MAX_PORTFOLIO_RISK=0.7
MIN_PROFIT_TARGET=100
DEFAULT_RISK_LEVEL=0.5
MIN_TRADE_AMOUNT=10
MAX_TRADE_AMOUNT=10000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log
